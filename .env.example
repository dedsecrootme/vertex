# Documentation only: Rust does not automatically load this file.
VERTEX_PORT=3000
# Select a dedicated public index, never your existing personal database.
# VERTEX_DB_DIR=C:\Vertex\public-data
# Both values below are required to enable the public mode.
# VERTEX_PUBLIC_ORIGIN=https://search.your-domain.example
# VERTEX_ADMIN_TOKEN=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# VERTEX_HOST=search.your-domain.example
# Central server only: accept bounded public URL suggestions.
# VERTEX_ALLOW_DISCOVERY=1
# Containers only; refused without authenticated public mode.
# VERTEX_BIND_HOST=0.0.0.0
# Desktop: public HTTPS origin, runtime env or set before compiling the installer.
# VERTEX_SHARED_API=https://search.your-domain.example
