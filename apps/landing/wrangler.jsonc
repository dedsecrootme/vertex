{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vertex-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "vertex-downloads" }],
  "vars": { "VERTEX_APP_URL": "" },
  "observability": { "enabled": false }
}
