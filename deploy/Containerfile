FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p api-rs -p crawler-rs

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 vertex && useradd --uid 10001 --gid vertex --no-create-home vertex \
    && mkdir /data && chown vertex:vertex /data
COPY --from=build /src/target/release/api-rs /usr/local/bin/vertex-api
COPY --from=build /src/target/release/crawler-rs /usr/local/bin/vertex-crawler
USER vertex
ENV VERTEX_DB_DIR=/data
WORKDIR /data
CMD ["vertex-api"]
